<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <RootNamespace>Translation.App</RootNamespace>
    <AssemblyName>Translation.App</AssemblyName>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- 显式升级传递依赖：2.1.11 捆绑的 e_sqlite3 有已知漏洞 (GHSA-2m69-gcr7-jv3q)。 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildProjectDirectory)\..\..\native\build\translation_core.dll"
             Link="translation_core.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\native\build\ctranslate2.dll"
             Link="ctranslate2.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\native\build\dnnl.dll"
             Link="dnnl.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyNativeDlls" AfterTargets="Build">
    <ItemGroup>
      <NativeFiles Include="$(MSBuildProjectDirectory)\..\..\native\build\translation_core.dll" />
      <NativeFiles Include="$(MSBuildProjectDirectory)\..\..\native\build\ctranslate2.dll" />
      <NativeFiles Include="$(MSBuildProjectDirectory)\..\..\native\build\dnnl.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
