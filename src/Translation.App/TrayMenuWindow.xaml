<Window x:Class="Translation.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translation"
        Width="168"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Background="#1F1F1F"
        Topmost="True"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- 键盘焦点环：仅键盘导航时显示（鼠标点击不显示，WPF FocusVisualStyle 默认行为） -->
        <Style x:Key="MenuFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="#2F6FED"
                                BorderThickness="1.5"
                                CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单项：取值与主窗口 FlatButton 一致（#333 hover / #222 按下 / #2F6FED 焦点环） -->
        <Style x:Key="TrayMenuItem" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource MenuFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#333333" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#222222" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 与主窗口完全相同的外框处理：1px #3A3A3A 描边，圆角交给 DWM（Win11） -->
    <Border Background="#1F1F1F"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            CornerRadius="0"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <StackPanel Margin="4">
            <Button x:Name="ShowItem"
                    Content="显示"
                    Style="{StaticResource TrayMenuItem}"
                    Click="Show_Click" />
            <Button x:Name="SettingsItem"
                    Content="设置"
                    Style="{StaticResource TrayMenuItem}"
                    Click="Settings_Click" />
            <Border Height="1"
                    Background="#333333"
                    Margin="6,4" />
            <Button x:Name="ExitItem"
                    Content="退出"
                    Style="{StaticResource TrayMenuItem}"
                    Click="Exit_Click" />
        </StackPanel>
    </Border>
</Window>
