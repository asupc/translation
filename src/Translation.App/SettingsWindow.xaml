<Window x:Class="Translation.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻译设置"
        Icon="Resources/app.ico"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1F1F1F"
        FontFamily="Microsoft YaHei UI">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="翻译设置"
                       Foreground="#F2F2F2"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16" />

            <TextBlock Text="全局热键"
                       Foreground="#8C8C8C"
                       FontSize="12"
                       Margin="0,0,0,6" />
            <TextBox x:Name="HotkeyBox"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     InputMethod.IsInputMethodEnabled="False"
                     Background="#2A2A2A"
                     Foreground="#F2F2F2"
                     CaretBrush="#F2F2F2"
                     BorderThickness="0"
                     Padding="8"
                     FontSize="14"
                     GotFocus="HotkeyBox_GotFocus"
                     LostFocus="HotkeyBox_LostFocus"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
            <TextBlock Text="点击热键框后直接按下组合键（需含 Ctrl/Alt/Shift/Win），Esc 恢复原值"
                       Foreground="#6F6F6F"
                       FontSize="11"
                       Margin="0,4,0,14" />

            <CheckBox x:Name="AutoStartBox"
                      Content="开机自动启动（最小化到托盘）"
                      Foreground="#E0E0E0"
                      FontSize="13"
                      Margin="0,0,0,16" />

            <TextBlock Text="默认使用离线翻译，不联网。百度在线引擎将在后续版本作为可选功能加入。"
                       Foreground="#6F6F6F"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Click="Cancel_Click"
                        Background="#333333"
                        Foreground="#F2F2F2"
                        BorderThickness="0"
                        Padding="14,6"
                        Margin="0,0,8,0" />
                <Button Content="保存"
                        Click="Save_Click"
                        Background="#2F6FED"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="14,6" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
