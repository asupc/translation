<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <RootNamespace>Translation.App</RootNamespace>
    <AssemblyName>Translation.App</AssemblyName>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 托盘图标通过 pack URI 读取，需要作为 WPF Resource 嵌入。 -->
    <Resource Include="Resources\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- 显式升级传递依赖：2.1.11 捆绑的 e_sqlite3 有已知漏洞 (GHSA-2m69-gcr7-jv3q)。 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildProjectDirectory)\..\..\native\build\translation_core.dll"
             Condition="Exists('$(MSBuildProjectDirectory)\..\..\native\build\translation_core.dll')"
             Link="translation_core.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\native\build\ctranslate2.dll"
             Condition="Exists('$(MSBuildProjectDirectory)\..\..\native\build\ctranslate2.dll')"
             Link="ctranslate2.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildProjectDirectory)\..\..\native\build\dnnl.dll"
             Condition="Exists('$(MSBuildProjectDirectory)\..\..\native\build\dnnl.dll')"
             Link="dnnl.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 原生 DLL 缺失时给出明确警告（运行时才会 DllNotFoundException，构建不应静默通过）。 -->
  <Target Name="WarnMissingNativeDlls" BeforeTargets="Build"
          Condition="!Exists('$(MSBuildProjectDirectory)\..\..\native\build\translation_core.dll') Or !Exists('$(MSBuildProjectDirectory)\..\..\native\build\ctranslate2.dll') Or !Exists('$(MSBuildProjectDirectory)\..\..\native\build\dnnl.dll')">
    <Warning Text="native/build 下的 translation_core.dll / ctranslate2.dll / dnnl.dll 不完整；应用可编译但运行时会加载失败。先运行 scripts\build-native.ps1。" />
  </Target>
</Project>
